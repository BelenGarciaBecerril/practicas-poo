<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.bel.practica3.PrimaryController" spacing="20.0" style="-fx-padding: 20; -fx-background-color: #fdf5e6;">
    <children>
        <HBox alignment="CENTER" spacing="20.0">
            <children>
                <Label text="Ingrese un número:" textFill="#FF69B4" style="-fx-font-size: 14px;" />
                <TextField fx:id="txtNumero" promptText="Ej. 6915" />
                <Button onAction="#analizar" text="Analizar" />
                <Button onAction="#limpiar" text="Limpiar" />
            </children>
        </HBox>
        
        <HBox spacing="20.0" alignment="CENTER">
            <children>
                <GridPane hgap="10.0" vgap="10.0">
                    <children>
                        <Label text="Cantidad de cifras" textFill="#FF69B4" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <TextField fx:id="txtCantidadCifras" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                        
                        <Label text="Suma de cifras impares" textFill="#FF69B4" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                        <TextField fx:id="txtSumaImpares" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        
                        <Label text="Suma de cifras pares" textFill="#FF69B4" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                        <TextField fx:id="txtSumaPares" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                        
                        <Label text="Suma total de cifras" textFill="#FF69B4" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                        <TextField fx:id="txtSumaTotal" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                        
                        <Label text="Cifra mayor" textFill="#FF69B4" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                        <TextField fx:id="txtMayor" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                        
                        <Label text="Cifra menor" textFill="#FF69B4" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                        <TextField fx:id="txtMenor" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                    </children>
                </GridPane>
                
                <VBox spacing="10.0">
                    <children>
                        <Label text="Divisores" textFill="#FF69B4" style="-fx-font-weight: bold;" />
                        <TextArea fx:id="txtDivisores" prefHeight="220.0" prefWidth="150.0" editable="false" style="-fx-control-inner-background: #fdf5e6; -fx-text-fill: #FF69B4;" />
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</VBox>