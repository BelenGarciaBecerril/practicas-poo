<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="com.bel.practicaliebreytortuga.PrimaryController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <Label text="Carrera: La Liebre y la Tortuga">
         <font>
            <Font name="System Bold" size="16.0" />
         </font>
      </Label>
      
      <Label text="Liebre:" />
      <ProgressBar fx:id="pbLiebre" prefHeight="25.0" prefWidth="350.0" progress="0.0" />
      <Label fx:id="lblLiebreEstado" text="Esperando..." />

      <Label text="Tortuga:">
         <VBox.margin>
            <Insets top="10.0" />
         </VBox.margin>
      </Label>
      <ProgressBar fx:id="pbTortuga" prefHeight="25.0" prefWidth="350.0" progress="0.0" />
      <Label fx:id="lblTortugaEstado" text="Esperando..." />

      <Button fx:id="btnIniciar" mnemonicParsing="false" onAction="#iniciarCarrera" prefHeight="35.0" prefWidth="130.0" text="Iniciar Carrera">
         <VBox.margin>
            <Insets top="15.0" />
         </VBox.margin>
      </Button>
   </children>
</VBox>