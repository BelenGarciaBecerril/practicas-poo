<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="com.bel.practicaconteo.PrimaryController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <Label text="Contar número de clics">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Label>
      <TextField fx:id="txtClics" alignment="CENTER" editable="false" prefHeight="35.0" prefWidth="300.0" />
      <Button fx:id="btnContar" mnemonicParsing="false" onAction="#contarClic" prefHeight="35.0" prefWidth="120.0" text="¡Contar!" />
      
      <Label text="Esperar 10 segundos">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
         <VBox.margin>
            <Insets top="15.0" />
         </VBox.margin>
      </Label>
      <ProgressBar fx:id="progressBar" prefHeight="25.0" prefWidth="320.0" progress="0.0" />
      <Button fx:id="btnEsperar" mnemonicParsing="false" onAction="#iniciarEspera" prefHeight="35.0" prefWidth="120.0" text="¡Esperar!" />
   </children>
</VBox>