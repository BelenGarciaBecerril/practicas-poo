<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.bel.practica2.PrimaryController" alignment="CENTER" spacing="20.0" style="-fx-padding: 20; -fx-background-color: #fff0f5;">
    <children>
        <HBox alignment="CENTER" spacing="10.0">
            <children>
                <Label text="Dinero:" textFill="#FF69B4" style="-fx-font-size: 14px;" />
                <TextField fx:id="txtDinero" promptText="Ej. 9999" />
                <Button onAction="#limpiar" text="X" />
                <Button onAction="#desglosar" text="Desglosar" />
            </children>
        </HBox>
        <TextArea fx:id="txtResultado" prefHeight="200.0" prefWidth="300.0" editable="false" style="-fx-control-inner-background: #fff0f5; -fx-text-fill: #FF69B4;" />
    </children>
</VBox>