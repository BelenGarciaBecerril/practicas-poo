<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.bel.practica5.PrimaryController" spacing="20.0" style="-fx-padding: 20; -fx-background-color: #fffaf0;">
    <children>
        <HBox spacing="50.0" alignment="CENTER">
            <children>
                <GridPane hgap="10.0" vgap="10.0">
                    <children>
                        <Label text="Alimentación" textFill="#FF69B4" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <TextField fx:id="txtAlimentacion" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                        
                        <Label text="Refrigerios" textFill="#FF69B4" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                        <TextField fx:id="txtRefrigerios" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        
                        <Label text="Transporte" textFill="#FF69B4" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                        <TextField fx:id="txtTransporte" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                        
                        <Label text="Telefonía" textFill="#FF69B4" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                        <TextField fx:id="txtTelefono" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                        
                        <Label text="Otros" textFill="#FF69B4" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                        <TextField fx:id="txtOtros" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                    </children>
                </GridPane>
                
                <VBox spacing="10.0">
                    <children>
                        <Label text="Estadísticas" textFill="#FF69B4" style="-fx-font-weight: bold; -fx-font-size: 14px;" />
                        
                        <Label text="Total semanal" textFill="#FF69B4" />
                        <TextField fx:id="txtTotal" editable="false" />
                        
                        <Label text="Gasto más alto" textFill="#FF69B4" />
                        <TextField fx:id="txtMayor" editable="false" />
                    </children>
                </VBox>
            </children>
        </HBox>
        
        <HBox alignment="CENTER" spacing="20.0">
            <children>
                <Button onAction="#calcularEstadisticas" text="Calcular estadísticas" />
                <Button onAction="#limpiar" text="Limpiar" />
            </children>
        </HBox>
    </children>
</VBox>